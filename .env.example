# Copia a .env (nunca se sube al repo)
# --- IA por defecto: Meta Muse Glimmer 30B (pesos abiertos) en local con Ollama
#   ollama pull hf.co/meta-models/Muse-Glimmer-30B-GGUF:Q4_K_M      (~18 GB con visión)
# Mac de 24 GB: cierra apps pesadas. Si va justo, usa la cuantización pequeña (~14 GB):
#   VOLSCAN_LLM_MODEL=hf.co/unsloth/Muse-Glimmer-30B-GGUF:UD-IQ3_M
VOLSCAN_LLM_BASE=http://localhost:11434/v1
VOLSCAN_LLM_MODEL=hf.co/meta-models/Muse-Glimmer-30B-GGUF:Q4_K_M
VOLSCAN_EMBED_MODEL=nomic-embed-text
# Profundidad de razonamiento de Glimmer: low (rápido) | medium | high | xhigh
VOLSCAN_REASONING_STRENGTH=low
# Segundos máximos por respuesta del modelo local
VOLSCAN_LLM_TIMEOUT=300

# --- Meta Model API (cuando lleguen los créditos): comenta VOLSCAN_LLM_BASE y rellena:
# META_API_KEY=
# VOLSCAN_LLM_MODEL=muse-spark-1.3

# --- Acceso: off = demo local sin usuarios (todo se registra igualmente en out/audit/audit.jsonl).
# on = pide usuario y contraseña. Crea usuarios con: python -m volscan.security add-user NOMBRE lector|tecnico|admin
VOLSCAN_AUTH=off
